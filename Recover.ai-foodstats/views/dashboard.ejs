<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>WellnessSync Dashboard - Recovr.AI</title>
    
    <link rel="stylesheet" href="/stylesheet/dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

   <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32x32.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon-16x16.png" />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/apple-touch-icon.png" />

    <link rel="manifest" href="/site.webmanifest" />

    <style>
        /* --- THEME VARIABLES --- */
        :root {
            --brand-green: #2ecc71;
            --brand-green-dark: #27ae60;
            --brand-blue: #4285f4;
            --bg-color: #f8f9fa;
            --card-bg: #ffffff;
            --text-dark: #333333;
            --nav-text: #555;
            --border-color: #e5e5e5;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            margin: 0;
            padding: 0;
            color: var(--text-dark);
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
        }

        /* --- NEW NAVBAR STYLES --- */
        .navbar {
            background-color: white;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-section {
            display: flex; align-items: center; gap: 12px;
            font-weight: 700; font-size: 1.4rem; color: var(--brand-green);
            text-decoration: none; letter-spacing: -0.5px;
        }
        
        /* Desktop Logo Scaling */
        .logo-section img {
            height: 35px;
            width: auto;
        }

        .nav-links { display: flex; gap: 32px; height: 100%; list-style: none; margin: 0; padding: 0; }

        .nav-item {
            text-decoration: none; color: var(--nav-text);
            font-weight: 500; font-size: 0.95rem; display: flex;
            align-items: center; height: 100%; border-bottom: 3px solid transparent;
            transition: all 0.2s; text-transform: capitalize;
        }

        .nav-item:hover { color: var(--brand-green); }
        .nav-item.active { color: black; border-bottom-color: var(--brand-green); }

        .nav-right { display: flex; align-items: center; gap: 15px; }

        .profile-icon {
            width: 36px; height: 36px; background-color: #e57373; color: white;
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; font-weight: 600; font-size: 0.9rem;
            cursor: pointer; overflow: hidden;
        }

        /* Added Logout Button Styling */
        .logout-btn {
            color: #666;
            font-size: 1.2rem;
            text-decoration: none;
            transition: color 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .logout-btn:hover { color: #d32f2f; }

        /* --- MOBILE HEADER --- */
        .mobile-header {
            display: none;
            background-color: white;
            height: 60px;
            align-items: center;
            justify-content: space-between; 
            padding: 0 15px;
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .mobile-logo {
            display: flex; align-items: center; gap: 8px;
            color: var(--brand-green); font-weight: 700; text-decoration: none;
            font-family: 'Inter', sans-serif; font-size: 1.2rem; letter-spacing: -0.5px; 
        }

        /* Mobile Logo Scaling */
        .mobile-logo img {
            height: 28px;
            width: auto;
        }

        .mobile-right {
            display: flex; align-items: center; gap: 15px;
        }

        /* --- DASHBOARD SPECIFIC STYLES --- */
        .container {
            flex: 1; max-width: 1200px; margin: 0 auto; padding: 24px; width: 100%; box-sizing: border-box;
            padding-bottom: calc(24px + env(safe-area-inset-bottom));
        }

        .welcome-header h1 { font-size: 1.8rem; margin-bottom: 5px; color: #333; }
        .welcome-header p { color: #777; margin-bottom: 20px; }

        .sync-box {
            background: white; padding: 20px; border-radius: 16px; margin-bottom: 25px;
            display: flex; justify-content: space-between; align-items: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02); border: 1px solid var(--border-color);
        }
        .btn-google {
            background-color: var(--brand-blue); color: white; padding: 10px 20px;
            text-decoration: none; border-radius: 8px; font-weight: 600; transition: opacity 0.2s;
        }
        .btn-google:hover { opacity: 0.9; }

        /* SINGLE ROW LAYOUT */
        .metrics-grid {
            display: flex; flex-wrap: nowrap; gap: 20px; overflow-x: auto;
            padding-bottom: 15px; scrollbar-width: thin;
        }

        .metric-card {
            background: white; padding: 20px; border-radius: 16px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02); border: 1px solid var(--border-color);
            min-width: 220px; flex: 1; position: relative;
        }

        .metrics-grid::-webkit-scrollbar { height: 6px; }
        .metrics-grid::-webkit-scrollbar-thumb { background-color: #ccc; border-radius: 10px; }

        /* Chart Section */
        .chart-section {
            background: white; padding: 20px; border-radius: 16px; 
            box-shadow: 0 4px 6px rgba(0,0,0,0.02); border: 1px solid var(--border-color);
            margin-top: 10px; margin-bottom: 30px;
        }
        .chart-header h3 { margin-bottom: 15px; color: #333; }

        /* Services Grid */
        .services-header { margin-bottom: 15px; color: #333; }
        
        .services-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px; margin-bottom: 40px;
        }

        .service-card {
            background: white; border-radius: 16px; overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02); border: 1px solid var(--border-color);
        }
        
        .service-img { height: 140px; background-size: cover; background-position: center; }
        .service-info { padding: 15px; display: flex; justify-content: space-between; align-items: center; }
        .service-info h4 { margin: 0; color: #333; }
        .book-btn { 
            background: #f0f2f5; border: none; padding: 8px 16px; border-radius: 20px; 
            cursor: pointer; font-weight: 600; color: #333; transition: all 0.2s; font-family: inherit;
        }
        .book-btn:hover { background: var(--brand-green); color: white; }
        .service-info a { text-decoration: none; }

        /* --- MOBILE RESPONSIVENESS --- */
        @media (max-width: 768px) {
            .navbar { display: none; } /* Hide desktop nav */
            .mobile-header { display: flex; } /* Show mobile header */
            
            .container { padding: 15px; }
            .sync-box { flex-direction: column; align-items: flex-start; gap: 15px; }
            .btn-google { width: 100%; text-align: center; }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="/dashboard" class="logo-section">
            <img src="/images/logo.png" alt="Recovr.AI Logo">
            <span>Recovr.AI</span>
        </a>
        
        <div class="nav-links">
            <a href="/dashboard" class="nav-item active">dashboard</a> 
            <a href="/food" class="nav-item">food analysis</a>
            <a href="/chat_bot" class="nav-item">AI buddy</a> 
            <a href="/community" class="nav-item">Community</a>
            <a href="/medication" class="nav-item">medication</a>
        </div>

        <div class="nav-right">
            <a href="/logout" class="logout-btn" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
            <div class="profile-icon">
                <%= typeof user !== 'undefined' && user.name ? user.name.substring(0, 2).toUpperCase() : 'SA' %>
            </div>
        </div>
    </nav>

    <div class="mobile-header">
        <a href="/dashboard" class="mobile-logo">
            <img src="/images/logo.png" alt="Recovr.AI Logo">
            Recovr.AI
        </a>
        <div class="mobile-right">
            <a href="/logout" class="logout-btn" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
            <div class="profile-icon" style="width: 32px; height: 32px; font-size: 0.8rem;">
                <%= typeof user !== 'undefined' && user.name ? user.name.substring(0, 2).toUpperCase() : 'SA' %>
            </div>
        </div>
    </div>

    <div class="container">
        <header class="welcome-header">
            <h1>Welcome back, <%= typeof user !== 'undefined' ? user.name : 'Guest' %></h1>
            <p>Your daily health overview.</p>
        </header>

        <div class="sync-box">
            <% if (locals.graphData && locals.graphData.isConnected) { %>
                <div style="display:flex; align-items:center; gap:15px;">
                    <i class="fas fa-check-circle" style="color: #00c897; font-size: 1.5rem;"></i>
                    <div>
                        <strong style="color:#333;">Synced with Google Fit</strong><br>
                        <small style="color:#666">Steps, Heart Rate & Burned Calories synced.</small>
                    </div>
                </div>
            <% } else { %>
                <div style="display:flex; align-items:center; gap:15px;">
                    <i class="fas fa-exclamation-circle" style="color: #ff8a00; font-size: 1.5rem;"></i>
                    <div>
                        <strong style="color:#333;">Connect Google Fit</strong><br>
                        <small style="color:#666">Sync to see your Heart Rate, Steps, and Sleep.</small>
                    </div>
                </div>
                <a href="/auth/google" class="btn-google">Connect Now</a>
            <% } %>
        </div>

        <div class="metrics-grid">
            
            <div class="metric-card">
                <span class="badge" style="font-size:0.75rem; color:#777; position:absolute; top:20px; right:20px;">Avg BPM</span>
                <div class="metric-icon" style="background: #ff4d6d; color:white; width:40px; height:40px; display:flex; align-items:center; justify-content:center; border-radius:10px; margin-bottom:15px;"><i class="fas fa-heart"></i></div>
                <h3 style="font-size:0.9rem; color:#555; margin-bottom:5px;">Heart Rate</h3>
                <div class="value" style="font-size:1.5rem; font-weight:700;"><%= locals.graphData && locals.graphData.todayHeartRate > 0 ? locals.graphData.todayHeartRate : '--' %> <span class="unit" style="font-size:0.9rem; color:#777;">bpm</span></div>
            </div>
            
            <div class="metric-card">
                <span class="badge" style="font-size:0.75rem; color:#777; position:absolute; top:20px; right:20px;">Activity</span>
                <div class="metric-icon" style="background: #ff9f43; color:white; width:40px; height:40px; display:flex; align-items:center; justify-content:center; border-radius:10px; margin-bottom:15px;"><i class="fas fa-fire"></i></div>
                <h3 style="font-size:0.9rem; color:#555; margin-bottom:5px;">Calories Burned</h3>
                <div class="value" style="font-size:1.5rem; font-weight:700;"><%= locals.graphData && locals.graphData.todayCaloriesBurned ? locals.graphData.todayCaloriesBurned : '--' %> <span class="unit" style="font-size:0.9rem; color:#777;">kcal</span></div>
            </div>

            <div class="metric-card">
                <span class="badge" style="font-size:0.75rem; color:#777; position:absolute; top:20px; right:20px;">Food Scan</span>
                <div class="metric-icon" style="background: #ff8a00; color:white; width:40px; height:40px; display:flex; align-items:center; justify-content:center; border-radius:10px; margin-bottom:15px;"><i class="fas fa-utensils"></i></div>
                <h3 style="font-size:0.9rem; color:#555; margin-bottom:5px;">Calories Intake</h3>
                <div class="value" style="font-size:1.5rem; font-weight:700;"><%= typeof user !== 'undefined' && user.nutrition ? user.nutrition.calories : 0 %> <span class="unit" style="font-size:0.9rem; color:#777;">kcal</span></div>
            </div>
            <div class="metric-card">
                <span class="badge" style="font-size:0.75rem; color:#777; position:absolute; top:20px; right:20px;">Today</span>
                <div class="metric-icon" style="background: #6c5ce7; color:white; width:40px; height:40px; display:flex; align-items:center; justify-content:center; border-radius:10px; margin-bottom:15px;"><i class="fas fa-shoe-prints"></i></div>
                <h3 style="font-size:0.9rem; color:#555; margin-bottom:5px;">Steps</h3>
                <div class="value" style="font-size:1.5rem; font-weight:700;"><%= locals.graphData ? locals.graphData.todaySteps : '--' %> <span class="unit" style="font-size:0.9rem; color:#777;">steps</span></div>
            </div>
            
            <div class="metric-card">
                <span class="badge" style="font-size:0.75rem; color:#777; position:absolute; top:20px; right:20px;">Last Night</span>
                <div class="metric-icon" style="background: #00c897; color:white; width:40px; height:40px; display:flex; align-items:center; justify-content:center; border-radius:10px; margin-bottom:15px;"><i class="fas fa-bed"></i></div>
                <h3 style="font-size:0.9rem; color:#555; margin-bottom:5px;">Sleep Cycle</h3>
                <div class="value" style="font-size:1.5rem; font-weight:700;"><%= locals.graphData ? locals.graphData.todaySleep : '--' %></div>
            </div>
        </div>

        <section class="chart-section">
            <div class="chart-header">
                <h3>Activity Trends (Steps)</h3>
            </div>
            <div style="height: 300px; width: 100%;">
                <canvas id="trendsChart"></canvas>
            </div>
        </section>

        <div class="services-header"><h3>Explore Services</h3></div>
        <div class="services-grid">
            <div class="service-card">
                <div class="service-img" style="background-image: url('https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=400&q=80')"></div>
                <div class="service-info"><h4>Medications</h4><a href="/medication"><button class="book-btn">Check</button></a></div>
            </div>
            <div class="service-card">
                <div class="service-img" style="background-image: url('https://images.unsplash.com/photo-1490645935967-10de6ba17061?auto=format&fit=crop&w=400&q=80')"></div>
                <div class="service-info"><h4>Food Analysis</h4><a href="/food"><button class="book-btn">Scan</button></a></div>
            </div>
            <div class="service-card">
                <div class="service-img" style="background-image: url('https://images.unsplash.com/photo-1684369175833-4b445ad6bfb5?q=80&w=1096&auto=format&fit=crop')"></div>
                <div class="service-info"><h4>Ai Buddy</h4><a href="/chat_bot"><button class="book-btn">Chat</button></a></div>
            </div>
            <div class="service-card">
                <div class="service-img" style="background-image: url('https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=400&q=80')"></div>
                <div class="service-info"><h4>Community</h4><a href="/community"><button class="book-btn">Chat</button></a></div>
            </div>
        </div>
    </div>

    <footer style="text-align:center; padding: 20px; color: #aaa; font-size: 0.85rem; margin-top: auto;">
        © 2026 Recovr.AI
    </footer>

    <script src="/javascript/dashboard.js"></script>
    <script>
        // Graph Data
        const graphData = <%- JSON.stringify(locals.graphData || { dates: [], steps: [] }) %>;
        const ctx = document.getElementById('trendsChart').getContext('2d');
        const labels = graphData.dates && graphData.dates.length ? graphData.dates : ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
        const stepsData = graphData.steps && graphData.steps.length ? graphData.steps : [0,0,0,0,0,0,0];

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Steps',
                    data: stepsData,
                    backgroundColor: '#2ecc71', /* Updated to match theme brand green */
                    borderRadius: 6,
                    barPercentage: 0.6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false } 
                },
                scales: {
                    y: { 
                        beginAtZero: true, 
                        grid: { borderDash: [5, 5], color: '#f0f0f0' },
                        border: { display: false }
                    },
                    x: { 
                        grid: { display: false },
                        border: { display: false }
                    }
                }
            }
        });
        
    </script>
</body>
</html>