<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Recovr.AI - Doctor Brain</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32x32.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon-16x16.png" />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/apple-touch-icon.png" />

    <link rel="manifest" href="/site.webmanifest" />

    <style>
      /* --- THEME VARIABLES --- */
      :root {
        --brand-green: #2ecc71;
        --brand-green-dark: #27ae60;
        --brand-blue: #4285f4;
        --bg-color: #f8f9fa;
        --card-bg: #ffffff;
        --text-dark: #333333;
        --nav-text: #555;
        --border-color: #e5e5e5;
        --shadow: 0 4px 12px rgba(0, 0, 0, 0.05);
        --radius: 16px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "Inter", sans-serif;
        background-color: var(--bg-color);
        color: var(--text-dark);
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      /* --- NAVBAR (Desktop) --- */
      .navbar {
        background-color: white;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        border-bottom: 1px solid var(--border-color);
        z-index: 100;
        flex-shrink: 0;
      }

      .logo-section {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        font-size: 1.4rem;
        color: var(--brand-green);
        text-decoration: none;
        letter-spacing: -0.5px;
      }

      /* Logo scaling */
      .logo-section img {
        height: 35px;
        width: auto;
      }

      .nav-links {
        display: flex;
        gap: 32px;
        height: 100%;
      }

      .nav-item {
        text-decoration: none;
        color: var(--nav-text);
        font-weight: 500;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        height: 100%;
        border-bottom: 3px solid transparent;
        transition: all 0.2s;
        text-transform: capitalize;
      }
      .nav-item:hover {
        color: var(--brand-green);
      }
      .nav-item.active {
        color: black;
        border-bottom-color: var(--brand-green);
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 15px;
      }

      .profile-icon {
        width: 36px;
        height: 36px;
        background-color: #e57373;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
      }

      /* --- MAIN LAYOUT --- */
      .main-container {
        flex: 1;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-height: 0;
      }

      .chat-card {
        background: var(--card-bg);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 0;
        border: 1px solid var(--border-color);
      }

      /* --- CHAT HEADER --- */
      .chat-header {
        background: #ffffff;
        padding: 15px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border-color);
        flex-shrink: 0;
        z-index: 10;
      }
      .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
      }

      .mobile-back-btn {
        display: none;
        color: var(--text-dark);
        margin-right: 5px;
        text-decoration: none;
        transition: color 0.2s;
      }
      .mobile-back-btn:hover {
        color: var(--brand-green);
      }

      .bot-info {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .bot-avatar {
        width: 40px;
        height: 40px;
        background: #eafff3;
        color: var(--brand-green-dark);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
      }
      .bot-status h3 {
        font-size: 1.1rem;
        color: #333;
        margin: 0;
      }
      .bot-status span {
        font-size: 0.75rem;
        color: var(--brand-green);
        font-weight: 600;
      }

      /* --- CHAT AREA --- */
      .chat-container {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        background-color: #fcfcfc;
      }

      .message {
        max-width: 85%;
        padding: 12px 18px;
        border-radius: 18px;
        font-size: 0.95rem;
        line-height: 1.5;
        position: relative;
        word-wrap: break-word;
      }

      .bot-msg {
        align-self: flex-start;
        background: white;
        color: #333;
        border-bottom-left-radius: 4px;
        border: 1px solid #eee;
      }
      .user-msg {
        align-self: flex-end;
        background: var(--brand-green);
        color: white;
        border-bottom-right-radius: 4px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
      }

      .bot-msg strong {
        color: var(--brand-blue);
        font-weight: 600;
        display: block;
        margin-top: 8px;
        margin-bottom: 4px;
      }
      .bot-msg strong:first-child {
        margin-top: 0;
      }
      .bot-msg ul {
        padding-left: 20px;
        margin: 5px 0;
      }
      .bot-msg li {
        margin-bottom: 4px;
      }

      .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: bold;
        margin-top: 10px;
      }
      .emergency {
        background-color: #ffebee;
        color: #c62828;
      }
      .stable {
        background-color: #e8f5e9;
        color: #2e7d32;
      }

      .typing-indicator {
        align-self: flex-start;
        background: white;
        padding: 10px 15px;
        border-radius: 18px;
        display: none;
        gap: 5px;
        border: 1px solid #eee;
      }
      .dot {
        width: 8px;
        height: 8px;
        background: #ccc;
        border-radius: 50%;
        animation: bounce 1.4s infinite ease-in-out;
      }
      .dot:nth-child(1) {
        animation-delay: -0.32s;
      }
      .dot:nth-child(2) {
        animation-delay: -0.16s;
      }
      @keyframes bounce {
        0%,
        80%,
        100% {
          transform: scale(0);
        }
        40% {
          transform: scale(1);
        }
      }

      /* --- INPUT AREA --- */
      .input-wrapper {
        background: white;
        border-top: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
      }

      .file-preview {
        display: none;
        padding: 10px 15px;
        background: #f9f9f9;
        border-bottom: 1px solid #eee;
      }
      .preview-box {
        display: inline-flex;
        align-items: center;
        background: #e8f5e9;
        padding: 5px 10px;
        border-radius: 8px;
        font-size: 0.85rem;
        color: #2e7d32;
        gap: 8px;
      }
      .remove-file {
        cursor: pointer;
        color: #d32f2f;
      }

      .input-area {
        padding: 10px 15px;
        padding-bottom: calc(10px + env(safe-area-inset-bottom));
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .attach-btn {
        font-size: 1.3rem;
        color: #777;
        cursor: pointer;
        padding: 5px;
        display: flex;
        align-items: center;
      }
      .chat-input {
        flex: 1;
        padding: 12px 15px;
        border-radius: 25px;
        border: 1px solid #ddd;
        background: #f9f9f9;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s;
        font-family: inherit;
      }
      .chat-input:focus {
        border-color: var(--brand-green);
        background: white;
      }
      .send-btn {
        width: 45px;
        height: 45px;
        background: var(--brand-green);
        border: none;
        border-radius: 50%;
        color: white;
        font-size: 1.2rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.2s;
      }
      .send-btn:hover {
        opacity: 0.9;
      }

      /* --- MOBILE RESPONSIVENESS --- */
      @media (max-width: 768px) {
        .navbar {
          display: none;
        }
        .main-container {
          padding: 0;
          margin: 0;
          gap: 0;
        }
        .chat-card {
          border-radius: 0;
          border: none;
          box-shadow: none;
        }
        .mobile-back-btn {
          display: flex;
        }
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <a href="/dashboard" class="logo-section">
        <img src="/images/logo.png" alt="Recovr.AI Logo" />
        <span>Recovr.AI</span>
      </a>

      <div class="nav-links">
        <a href="/dashboard" class="nav-item">dashboard</a>
        <a href="/food" class="nav-item">food analysis</a>
        <a href="/chat_bot" class="nav-item active">AI buddy</a>
        <a href="/community" class="nav-item">Community</a>
        <a href="/medication" class="nav-item">medication</a>
      </div>

      <div class="nav-right">
        <div class="profile-icon">
          <%= typeof user !== 'undefined' && user.name ? user.name.substring(0,
          2).toUpperCase() : 'SA' %>
        </div>
      </div>
    </nav>

    <div class="main-container">
      <div class="chat-card">
        <header class="chat-header">
          <div class="header-left">
            <a href="/dashboard" class="mobile-back-btn">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
            </a>

            <div class="bot-info">
              <div class="bot-avatar"><i class="fas fa-user-md"></i></div>
              <div class="bot-status">
                <h3>Doctor Brain</h3>
                <span>● Online</span>
              </div>
            </div>
          </div>
        </header>

        <div class="chat-container" id="chatContainer">
          <div class="message bot-msg">
            Hello! I'm Doctor Brain. Describe your symptoms or upload a medical
            image (X-ray, skin condition, etc.) and I will analyze it for you.
          </div>

          <div class="typing-indicator" id="typingIndicator">
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot"></div>
          </div>
        </div>

        <div class="input-wrapper">
          <div class="file-preview" id="filePreview">
            <div class="preview-box">
              <i class="fas fa-image"></i>
              <span id="fileName">image.png</span>
              <i class="fas fa-times remove-file" onclick="clearFile()"></i>
            </div>
          </div>

          <form class="input-area" id="chatForm">
            <input
              type="file"
              id="fileInput"
              name="image"
              accept="image/*"
              style="display: none"
              onchange="handleFileSelect()" />

            <label for="fileInput" class="attach-btn"
              ><i class="fas fa-paperclip"></i
            ></label>
            <input
              type="text"
              class="chat-input"
              id="userInput"
              placeholder="Message Doctor Brain..."
              autocomplete="off" />
            <button type="submit" class="send-btn">
              <i class="fas fa-paper-plane"></i>
            </button>
          </form>
        </div>
      </div>
    </div>

    <script>
      // --- CONFIGURATION ---
      const API_URL = "https://recover-ai-chat-bot.onrender.com/analyze";
      const API_KEY = "1234";

      // --- DOM ELEMENTS ---
      const chatContainer = document.getElementById("chatContainer");
      const form = document.getElementById("chatForm");
      const input = document.getElementById("userInput");
      const fileInput = document.getElementById("fileInput");
      const typing = document.getElementById("typingIndicator");
      const filePreview = document.getElementById("filePreview");
      const fileNameSpan = document.getElementById("fileName");

      // --- VOICE INPUT SETUP ---
      const micBtn = document.createElement("button");
      micBtn.type = "button";
      micBtn.innerHTML = '<i class="fas fa-microphone"></i>';
      micBtn.style.cssText =
        "background:none; border:none; font-size: 1.3rem; color: #777; cursor: pointer; padding: 5px; display: flex; align-items: center;";

      form.insertBefore(micBtn, input);

      const SpeechRecognition =
        window.SpeechRecognition || window.webkitSpeechRecognition;
      if (SpeechRecognition) {
        const recognition = new SpeechRecognition();
        recognition.continuous = false;
        recognition.lang = "en-US";

        micBtn.onclick = () => {
          recognition.start();
          micBtn.style.color = "#d32f2f";
        };

        recognition.onend = () => {
          micBtn.style.color = "#777";
        };

        recognition.onresult = (event) => {
          input.value = event.results[0][0].transcript;
        };
      } else {
        micBtn.style.display = "none";
      }

      function scrollToBottom() {
        chatContainer.scrollTop = chatContainer.scrollHeight;
      }

      function handleFileSelect() {
        const file = fileInput.files[0];
        if (file) {
          fileNameSpan.innerText = file.name;
          filePreview.style.display = "block";
          input.placeholder = "Add a caption (optional)...";
          input.focus();
        }
      }

      function clearFile() {
        fileInput.value = "";
        filePreview.style.display = "none";
        input.placeholder = "Message Doctor Brain...";
      }

      function addMessage(htmlContent, sender) {
        const div = document.createElement("div");
        div.classList.add(
          "message",
          sender === "user" ? "user-msg" : "bot-msg",
        );
        div.innerHTML = htmlContent;

        if (sender === "bot") {
          const speakBtn = document.createElement("button");
          speakBtn.innerHTML = '<i class="fas fa-volume-up"></i>';
          speakBtn.style.cssText =
            "background:none; border:none; cursor: pointer; margin-top: 5px; float: right; color: #4285f4; font-size: 1rem;";
          speakBtn.onclick = () => {
            const temp = document.createElement("div");
            temp.innerHTML = htmlContent;
            const text = temp.innerText;
            window.speechSynthesis.cancel();
            window.speechSynthesis.speak(new SpeechSynthesisUtterance(text));
          };
          div.appendChild(speakBtn);
        }

        chatContainer.insertBefore(div, typing);
        scrollToBottom();
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const text = input.value.trim();
        const file = fileInput.files[0];

        if (!text && !file) return;

        let userDisplay = text ? text.replace(/\n/g, "<br>") : "";
        if (file)
          userDisplay += `<br><small><i>📎 [Attachment: ${file.name}]</i></small>`;
        addMessage(userDisplay, "user");

        const formData = new FormData();
        formData.append("query", text || "Analyze this image");
        if (file) {
          formData.append("file", file);
        }

        input.value = "";
        clearFile();

        typing.style.display = "flex";
        scrollToBottom();

        try {
          const response = await fetch(API_URL, {
            method: "POST",
            headers: { "x-api-key": API_KEY },
            body: formData,
          });

          const data = await response.json();
          typing.style.display = "none";

          if (response.ok) {
            const statusClass = data.is_emergency ? "emergency" : "stable";
            const statusText = data.is_emergency
              ? "🚨 Seek Medical Help"
              : "✅ Stable Condition";

            const dietSection =
              data.diet_plan && data.diet_plan.length > 0
                ? `<strong>🥗 Suggested Diet:</strong><ul>${data.diet_plan.map((d) => `<li>${d}</li>`).join("")}</ul>`
                : "";

            const remediesSection =
              data.remedies && data.remedies.length > 0
                ? `<strong>💊 Remedies:</strong><ul>${data.remedies.map((r) => `<li>${r}</li>`).join("")}</ul>`
                : "";

            const aiHTML = `
                        <strong>Diagnosis: ${data.potential_diagnosis}</strong>
                        <p>${data.findings}</p>
                        ${remediesSection}
                        ${dietSection}
                        <span class="status-badge ${statusClass}">${statusText}</span>
                    `;

            addMessage(aiHTML, "bot");
          } else {
            addMessage(`⚠️ Error: ${data.detail || "Server issue"}`, "bot");
          }
        } catch (error) {
          console.error(error);
          typing.style.display = "none";
          addMessage(
            "⚠️ Connection failed. Please check your internet or the API URL.",
            "bot",
          );
        }
      });

      // Swipe Gesture (Right to Go Back)
      let touchStartX = 0;
      document.addEventListener(
        "touchstart",
        (e) => (touchStartX = e.changedTouches[0].screenX),
      );
      document.addEventListener("touchend", (e) => {
        if (e.changedTouches[0].screenX - touchStartX > 70)
          window.location.href = "/dashboard";
      });
      // Voice Guide Feature
document.addEventListener('DOMContentLoaded', () => {
    addVoiceGuideButton("Input specific symptoms or upload clinical reports for data-driven health summaries.");
});

function addVoiceGuideButton(text) {
    const btn = document.createElement("button");
    btn.innerHTML = "🔊 Page Guide";
    btn.style.cssText = "position:fixed;bottom:20px;right:20px;z-index:1000;padding:10px 20px;background:#00c897;color:white;border:none;border-radius:25px;cursor:pointer;box-shadow:0 4px 15px rgba(0,0,0,0.2);font-weight:bold;font-family:sans-serif;";
    
    btn.onclick = () => {
        if (window.speechSynthesis.speaking) {
            window.speechSynthesis.cancel();
        } else {
            const speech = new SpeechSynthesisUtterance(text);
            window.speechSynthesis.speak(speech);
        }
    };
    document.body.appendChild(btn);
}
    </script>
  </body>
</html>
